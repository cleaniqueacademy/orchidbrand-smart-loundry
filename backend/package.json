{
  "name": "cleanique-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:push": "bunx drizzle-kit push",
    "db:push:force": "bunx drizzle-kit push --force",
    "db:seed": "bun src/db/seed.ts",
    "db:push-users": "bun src/scripts/pushUsersFromLocalTxt.ts",
    "db:studio": "bunx drizzle-kit studio",
    "build": "bun build src/index.ts --target=bun --packages=external --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "db:bootstrap-admin": "bun src/scripts/bootstrapAdmin.ts",
    "db:hash-legacy": "bun src/scripts/hashLegacyPasswords.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.16",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.7.3"
  }
}
