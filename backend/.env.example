PORT=5000
# Local Docker PostgreSQL (Port 5433)
DATABASE_URL=
# Or Cloud PostgreSQL (Supabase / Neon / AWS RDS / Railway)
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/cleanique_laundry?sslmode=require

JWT_SECRET=
GEMINI_API_KEY=
AIVENE_API_KEY=
# Required HTTPS origin in production, without trailing slash
APP_ORIGIN=

# Paket Premium (multi-cabang, staf, harga lebih tinggi); biarkan true sampai siap rilis
PREMIUM_COMING_SOON=true

# Midtrans Snap redirect: aktif otomatis jika MIDTRANS_SERVER_KEY diisi (set MIDTRANS_ENABLED=false untuk paksa nonaktif).
# Jika MIDTRANS_SERVER_KEY kosong, sistem otomatis fallback ke QRIS Saurus & transfer bank (upload bukti).
MIDTRANS_ENABLED=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
