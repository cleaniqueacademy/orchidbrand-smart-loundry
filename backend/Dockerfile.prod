FROM oven/bun:1.4.4-alpine
WORKDIR /app
COPY package.json bun.lock ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN bun install --frozen-lockfile --ignore-scripts
COPY backend backend
COPY frontend/public/qris.png backend/assets/qris.png
WORKDIR /app/backend
RUN mkdir -p data/uploads data/wa_sessions && chown -R bun:bun data
USER bun
ENV NODE_ENV=production PORT=5000 UPLOADS_DIR=/app/backend/data/uploads WA_SESSIONS_DIR=/app/backend/data/wa_sessions
EXPOSE 5000
CMD ["bun", "src/index.ts"]
