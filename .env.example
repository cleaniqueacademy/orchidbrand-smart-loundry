# Port akses web publik di Host VPS (Default: 80 untuk HTTP langsung)
# Jika port 80 sudah dipakai oleh Nginx/Apache host, ubah misal: 8080
APP_PORT=80

# Kredensial Database PostgreSQL (Internal Docker Container)
POSTGRES_USER=orchid_admin
POSTGRES_PASSWORD=GantiDenganPasswordSuperAman2026!
POSTGRES_DB=orchid_laundry

# Secret Token untuk JWT Authentication
JWT_SECRET=orchid_super_secret_jwt_key_indotech_production_2026_change_me
