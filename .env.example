# =========================================================
# Laundry Cleanique - Docker Compose Environment Variables
# Copy file ini menjadi .env lalu isi semua value yang kosong
# =========================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=           # WAJIB DIISI: password kuat, jangan default!
POSTGRES_DB=cleanique_laundry

# --- Backend ---
JWT_SECRET=                  # WAJIB DIISI: random string panjang (min 32 karakter)
GEMINI_API_KEY=
AIVENE_API_KEY=

# --- Opsional ---
# APP_PORT=8081
# LANDING_PORT=4174
