# ============================================
# Orchid Brand Smart Laundry - Monorepo .gitignore
# ============================================

# --- Dependencies (Node / Bun) ---
node_modules
node_modules/
*/node_modules
*/node_modules/
**/node_modules
**/node_modules/
**/node_modules/**

# --- Bun Runtime & Cache ---
.bun
.bun/
**/.bun
**/.bun/
bun.lockb
**/bun.lockb

# --- Build Outputs & Bundler Cache ---
dist
dist/
**/dist
**/dist/
**/dist/**
build
build/
**/build
**/build/
**/build/**
.vite
.vite/
**/.vite
**/.vite/
**/.vite/**
.turbo
.turbo/
**/.turbo
**/.turbo/
.cache
.cache/
**/.cache
**/.cache/

# --- Environment Variables & Secrets ---
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example

# --- Database & Storage (SQLite) ---
*.db
*.db-*
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-*
backend/data/*.sqlite
backend/data/
**/data/*.db
**/data/

# --- Drizzle Migrations (Local temp) ---
backend/drizzle/
**/drizzle/

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
**/*.log

# --- IDE & Operating System ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini

# --- TypeScript ---
*.tsbuildinfo
.tscache/

# --- Testing & Coverage ---
coverage/
*.lcov
.nyc_output/
