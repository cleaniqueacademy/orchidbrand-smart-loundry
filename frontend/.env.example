# =========================================================
# Orchid Brand Smart Laundry - Frontend Environment Variables
# =========================================================

# Target Proxy Backend untuk development lokal Vite (Proxy /api)
VITE_PROXY_TARGET=

# Opsional: Base URL Backend jika frontend di-deploy terpisah (misal di Vercel/Netlify)
# Kosongkan atau biarkan default "/api" jika menggunakan Nginx/Vite proxy
# VITE_API_BASE_URL=/api

# Opsional: Port dev server lokal Vite (default 5173)
PORT=
